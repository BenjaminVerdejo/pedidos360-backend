# Copiar a .env y completar. El archivo .env esta en .gitignore: NUNCA subirlo a GitHub.
# Generar valores aleatorios, por ejemplo:  openssl rand -base64 24

# RabbitMQ
RABBIT_USER=admin
RABBIT_PASSWORD=
RABBIT_COOKIE=

# Base de datos (local: contenedor postgres | produccion: AWS RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos360
DB_USER=postgres
DB_PASSWORD=
# validate en produccion; update solo para crear el esquema la primera vez
JPA_DDL_AUTO=update

# Frontend permitido por CORS (separar con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200
